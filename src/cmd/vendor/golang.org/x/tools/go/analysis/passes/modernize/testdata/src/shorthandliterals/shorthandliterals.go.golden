package shorthandliterals

import "set"

func sliceLit() {
	_ = ["a", "b"] // want "slice composite literal can use array literal syntax"
}

func mapLit() {
	_ = {"a": "b"} // want "map composite literal can use dict literal syntax"
}

func setLit() {
	_ = {"a", "b"} // want "set.Of call can use set literal syntax"
}
